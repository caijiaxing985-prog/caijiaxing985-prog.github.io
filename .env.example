# Required: exact public HTTPS origin, no path. Replace with your real hostname.
PUBLIC_ORIGIN=https://wenan.example.com
# Required only for first initialization: administrator sets a strong unique password.
# Leave blank here; no default password ships in the package.
ADMIN_PASSWORD=
# Used for running directly with Node.js. Docker overrides these inside the container.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
